# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên GitHub.
MONGODB_URI=mongodb+srv://TEN_USER:MAT_KHAU@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=spark-mind

# Khóa bí mật để băm IP (HMAC). Đặt một chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SECRET=

# Khóa để Apps Script gửi form vào /api/ingest/google-form và để gọi /api/admin/memory (header x-api-key). Đặt chuỗi ngẫu nhiên dài.
INGEST_SECRET=

# Chỉ đặt BAT_TAI_LIEU_API=1 khi chạy thử trên máy (bật /docs, /redoc, /openapi.json). KHÔNG đặt trên Render.
# BAT_TAI_LIEU_API=1
