# Dữ liệu người trả lời (có tên trường, không đưa lên GitHub)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Khóa bí mật
.env

# Python và Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/

# Kết quả sinh ra, tạo lại được bằng một lệnh
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Bảng duyệt tên trường sinh từ dữ liệu người trả lời
content/school_review.csv

# Các file khác
CLAUDE.md
note_private.md

# Mã tham gia là bí mật, không đưa lên GitHub
outputs/codes_*.csv

# Mã tham gia và mọi file CSV sinh ra trong outputs/ là bí mật/dữ liệu cá nhân, không đưa lên GitHub
outputs/*.csv

# Sao lưu MongoDB: có email người tham gia và băm mật khẩu, không bao giờ commit
backups/
