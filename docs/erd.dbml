// ERD for dbdiagram.io (final 19/11/2026). Source of truth for the MongoDB collections.
Project spark_mind {  // project name only; the real MongoDB database on Atlas is named "spark-mind" (hyphen)
  database_type: 'MongoDB'
}

Table schools {
  id objectid [pk]
  name varchar [not null]
  abbreviation varchar
  name_key varchar [note: 'accent-free lowercase key for matching']
  level varchar [note: 'THCS / THPT / Đại học / Liên cấp']
  indexes { name_key }
}

Table survey_raw {
  id varchar [pk, note: 'hash of the content, same form never duplicates']
  source varchar [note: 'google_form | web | excel_import']
  submitted_at datetime
  a1_grade varchar
  a2_gender varchar
  a3_school varchar [note: 'free text as typed']
  a4_uses_ai varchar
  b1_tools varchar
  b2_frequency varchar
  b3 varchar [note: 'chọn nhiều, dạng "1,3"']
  b3_purposes varchar
  b4_1 int
  b4_2 int
  b4_3 int
  b4_4 int
  b4_5 int
  b4_6 int
  b4_7 int
  b5_duration varchar
  b6_prompting varchar
  b7_after_answer varchar
  c1 int
  c2 int
  c3 int
  c4 int
  c5 int
  c6 varchar
}

Table survey_clean {
  id varchar [pk, note: 'same id as survey_raw']
  batch varchar
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  creativity_score float [note: '0-100']
  behavior_score float
  level varchar [note: 'Thap / Trung_binh / Cao']
  grade_level varchar [note: 'THCS / THPT / Đại học, from the grade']
  school_key varchar
  school_id objectid
  flag_straightline_12 boolean
  flag_straightline_c boolean
  flag_straightline_b boolean
  flag_contradiction boolean
  in_main boolean
  in_strict boolean
  in_very_strict boolean
}

Table access_codes {
  id objectid [pk]
  code varchar [unique, not null]
  source varchar [note: 'hired_team | volunteer']
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  batch varchar [note: 'tên lô tạo mã (make_codes.py --batch, vd lop_khoa_a, nhom_thue_1); null nếu không đặt lô (mã tạo trước 24/11)']
  is_used boolean [default: false]
  used_at datetime
  created_at datetime
}

Table participants {
  id objectid [pk]
  code_id objectid [not null]
  source varchar [note: 'hired_team | volunteer']
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  email varchar [not null, note: 'normalized, NOT unique, used to count submissions per email']
  grade varchar
  gender varchar
  school_name varchar
  school_id objectid
  consent boolean [not null]
  consent_at datetime
  guardian_consent boolean [note: 'required if under 18']
  ip_hash varchar [note: 'HMAC with secret key, for flagging only']
  session_token varchar [unique, note: 'random token (secrets.token_urlsafe), sent to the browser; never exported']
  user_agent varchar
  started_at datetime
  completed_at datetime [note: 'gán MỘT LẦN (không ghi đè) khi đã nộp đủ mọi game trong config.GAME_BAT_BUOC (hiện 1, 2, 3); trống = chưa hoàn thành']
  sua_luc datetime [note: 'lần sửa phần A gần nhất (nút Quay lại); trống nếu chưa sửa']
  so_lan_sua int [note: 'số lần sửa phần A']
  flags "varchar[]" [note: 'cờ chống gian lận, mỗi cờ dạng mã:bước. Mã: lam_qua_nhanh | mot_dap_an | bi_gian_doan; bước: form_b | khoi_c | game1 | game2. Chỉ hướng 2. Tính lại toàn bộ mỗi lần nộp một bước (flags_store.py) hoặc bằng scripts/compute_flags.py. KHÔNG được làm biến mô hình']
  flag_count int [note: 'số cờ KHÔNG tính bi_gian_doan (cờ này chỉ để tham khảo). KHÔNG được làm biến mô hình']
  indexes {
    code_id [unique]
    email
    ip_hash
    session_token [unique]
  }
}

Table behavior_answers {
  id objectid [pk]
  participant_id objectid [unique, not null]
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  a4 varchar [note: 'uses_ai: 1-4; 4 = Chưa bao giờ sử dụng thì B1-B7 có thể trống']
  b1 varchar [note: 'chọn nhiều, dạng "1,3"']
  b1_other varchar [note: 'chữ gõ ở "Mục khác:" của B1; trống nếu không chọn']
  b2_frequency varchar
  b3 varchar [note: 'chọn nhiều, dạng "1,3"']
  b3_other varchar [note: 'chữ gõ ở "Mục khác:" của B3; trống nếu không chọn']
  b5_duration varchar
  b6_prompting varchar [note: 'chọn nhiều, dạng "1,3"']
  b6_other varchar [note: 'chữ gõ ở "Mục khác:" của B6; trống nếu không chọn']
  b7_after_answer varchar
  b4_1 int
  b4_2 int
  b4_3 int
  b4_4 int
  b4_5 int
  b4_6 int
  b4_7 int
  duration_sec int
  thoi_gian_cau json [note: 'số đo thời gian từng câu Likert từ trình duyệt (chỉ số): khoang_ms {câu: mili giây từ câu trả lời trước, đã trừ ẩn tab}, sua_cuoi_ms {câu: mốc lần sửa cuối}, an_tab_ms (tổng thời gian ẩn tab), tong_ms (từ lúc hiện trang đến lúc nộp, đã trừ ẩn tab). Các câu: B4_1..B4_7. Chỉ để gắn cờ, KHÔNG được làm biến mô hình. Không ghi đè khi sửa lại']
  sua_luc datetime [note: 'lần sửa gần nhất (nút Quay lại)']
  so_lan_sua int [note: 'số lần sửa']
}

Table self_assessment {
  id objectid [pk]
  participant_id objectid [unique, not null]
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  c1 int
  c2 int
  c3 int
  c4 int
  c5 int
  c6 varchar
  creativity_score float
  thoi_gian_cau json [note: 'số đo thời gian từng câu Likert từ trình duyệt (chỉ số): khoang_ms {câu: mili giây từ câu trả lời trước, đã trừ ẩn tab}, sua_cuoi_ms {câu: mốc lần sửa cuối}, an_tab_ms (tổng thời gian ẩn tab), tong_ms (từ lúc hiện trang đến lúc nộp, đã trừ ẩn tab). Các câu: C1..C5. Chỉ để gắn cờ, KHÔNG được làm biến mô hình. Không ghi đè khi sửa lại']
  sua_luc datetime [note: 'lần sửa gần nhất (nút Quay lại)']
  so_lan_sua int [note: 'số lần sửa']
}

Table game_responses {
  id objectid [pk]
  participant_id objectid [not null]
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  game int [not null, note: '1 | 2 | 3']
  prompt_id varchar [note: 'game 1: id đồ vật; game 2: "game2" (một đề cố định); game 3: "game3" (hai tình huống cố định)']
  answer json [note: 'game 1: {ideas, n_ideas}. game 2: {selected_ids (id các ý chọn là SAI, theo thứ tự hiển thị), score 0-5, n_correct, n_wrong}. game 3 (MỘT bản ghi mỗi người, ghi MỘT lần cho cả hai tình huống khi bấm Nộp bài; mỗi tình huống một mục): {tinh_huong: [{tinh_huong_id "g3_t1"|"g3_t2", noi_dung (đúng văn bản người chơi nhập), so_tu, thoi_gian_lam (giây dùng ô nhập của tình huống đó, TRÌNH DUYỆT đo, trừ lúc ẩn tab; chỉ để gắn cờ), so_lan_dan, so_lan_roi_tab, nop_luc}]}. Điểm AI và điểm người chấm của game 3 KHÔNG nằm ở đây: sẽ thêm sau (1-4/12) ở collection riêng, khóa (participant_id, tinh_huong_id), nên không đổi cấu trúc này']
  duration_sec int [note: 'game 3: thời gian cả game do SERVER tính (lúc nộp trừ started_at), không phải tổng thoi_gian_lam']
  paste_count int [note: 'game 3: tổng so_lan_dan']
  tab_leave_count int [note: 'game 3: tổng so_lan_roi_tab']
  answer_length int [note: 'game 3: tổng số ký tự các tình huống']
  started_at datetime [note: 'do SERVER ghi khi bắt đầu game']
  over_time bool [note: 'nộp trễ quá 15 giây so với giới hạn']
  submitted_at datetime [note: 'null = chưa nộp. Game 3: gán khi nộp bài (một lần, cả 2 tình huống)']
  indexes { (participant_id, game) [unique] }
}

Table scores {
  id objectid [pk]
  response_id objectid [not null]
  data_label varchar [note: 'thu | pilot | that. Missing is treated as that (safe: never deleted by the test-data cleanup). Set by make_codes.py --data-label, copied access_codes -> participants -> child tables']
  rater varchar [note: 'auto | model name | human_1 | human_2']
  criteria json [note: 'score per criterion']
  total float
  model_name varchar
  model_version varchar
  prompt_version varchar
  scored_at datetime
  indexes { (response_id, rater) [unique] }
}

Table users {
  id objectid [pk]
  username varchar [unique, not null, note: 'lowercase, 3-32 chars (a-z 0-9 . _ -)']
  display_name varchar
  role varchar [not null, note: 'admin | viewer | rater']
  password_hash varchar [not null, note: 'scrypt$n$r$p$salt_hex$hash_hex (hashlib.scrypt, random salt, params stored). NEVER returned by any API']
  must_change_password boolean [note: 'true for temp passwords: only change-password works until it is changed']
  is_active boolean [default: true, note: 'false = locked by admin']
  created_at datetime [note: 'UTC']
  created_by varchar [note: 'username of the admin, or "script"']
  last_login_at datetime
  failed_attempts int [note: 'wrong passwords since last success; display only']
  locked_until datetime [note: 'last throttle lock; display only, the lock itself lives in login_attempts']
  indexes { username [unique] }
}

Table admin_sessions {
  id varchar [pk, note: 'SHA-256 of the random cookie token (the raw token is never stored)']
  user_id objectid [not null]
  csrf_token varchar [note: 'returned by GET /api/auth/me, must be sent as X-CSRF-Token on POST/PUT/PATCH/DELETE']
  created_at datetime
  last_seen_at datetime [note: 'idle timeout 2 hours']
  expires_at datetime [note: 'min(last_seen_at + 2h, created_at + 12h); TTL index (expireAfterSeconds=0)']
  indexes { expires_at [note: 'TTL'] user_id }
}

Table login_attempts {
  id varchar [pk, note: 'SHA-256 of "username|IP" (raw IP never stored; works for unknown usernames too)']
  count int [note: 'wrong passwords in the current 15-minute window']
  window_start datetime
  locked_until datetime [note: '5 wrong in 15 minutes -> locked 15 minutes']
  user_id objectid [note: 'null if the username does not exist']
  expires_at datetime [note: 'TTL index (expireAfterSeconds=0)']
}

Table audit_log {
  id objectid [pk]
  at datetime [note: 'UTC. Append-only: the code has no update/delete function']
  user_id objectid
  username varchar
  role varchar
  action varchar [note: 'login | login_failed | logout | change_password | user_create | user_create_script | user_reset_password | user_lock | user_unlock | data_create | data_update | data_delete | data_export | test_data_delete | rating_sample | rating_lock | rating_unlock | rating_export | rating_key_export']
  collection varchar
  doc_id varchar
  detail json [note: 'never contains passwords, hashes or tokens (filtered)']
  indexes { at }
}

// ---------- Chấm điểm trên web (phiên 3, 26/11/2026) ----------
Table rating_batches {
  id objectid [pk]
  name varchar [not null, unique, note: 'tên đợt, vd pilot_28_11 (chỉ chữ không dấu, số, _ -)']
  data_label varchar [not null, note: 'thu | pilot | that; một đợt chỉ chứa một nhãn. Nhãn thu/pilot bị "Xóa dữ liệu thử" xóa cùng đợt']
  raters varchar [note: 'mảng username được giao; rỗng = mọi tài khoản rater']
  locked bool [note: 'true: người chấm không lưu hay sửa được']
  locked_at datetime
  created_at datetime
}

Table rating_items {
  id objectid [pk]
  item_code varchar [not null, unique, note: 'G1-0001, G3-0001... cấp SAU khi trộn thứ tự nên không suy ra được người chơi. Đây là thứ DUY NHẤT người chấm nhìn thấy để định danh']
  game int [not null, note: '1 hoặc 3']
  noi_dung json [not null, note: 'chép từ game_responses. Game 1: {do_vat, cong_dung}; game 3: {tinh_huong, ai_goc, y_tuong}']
  participant_id objectid [note: 'CHỈ quản trị: để đối chiếu. Không bao giờ trả cho người chấm']
  nguon_khoa varchar [note: 'game 1: y<số thứ tự ý trong bài>; game 3: tinh_huong_id. Cùng participant_id tạo khóa chống rút lại']
  prompt_id varchar [note: 'CHỈ quản trị: id đồ vật (game 1) hoặc tinh_huong_id (game 3)']
  data_label varchar
  rating_batch varchar [not null]
  thu_tu int [note: 'thứ tự đã trộn trong đợt; mọi người chấm thấy cùng thứ tự']
  rut_luc datetime
  seed int
  indexes { item_code [unique] (rating_batch, participant_id, game, nguon_khoa) [unique] }
}

Table ratings {
  id objectid [pk]
  item_code varchar [not null]
  rater varchar [not null, note: 'username']
  rating_batch varchar
  diem json [note: 'game 1: {nhom: A..H | X}; game 3: {them_y_moi, khac_goc, kha_thi}, mỗi cái 1-5 hoặc X. Bản nháp có thể thiếu khóa']
  hoan_tat bool [note: 'đủ điểm chưa; chỉ bản hoàn tất tính vào tiến độ và độ đồng thuận']
  ghi_chu varchar
  thoi_gian_cham_giay int [note: 'đo ở trình duyệt (trừ lúc ẩn tab), của LẦN LƯU ĐẦU']
  thoi_gian_sua_giay int [note: 'cộng dồn thời gian các lần mở lại để sửa']
  tao_luc datetime
  sua_luc datetime
  indexes { (item_code, rater) [unique] }
}

// Chưa làm (để chỗ): ai_scores, khóa item_code, điểm AI để so với điểm người chấm.
Table ai_scores {
  item_code varchar [pk, note: 'CHƯA TẠO. Làm ở phiên sau; điểm AI không bao giờ hiện cho người chấm']
}

Ref: rating_batches.name < rating_items.rating_batch
Ref: rating_items.item_code < ratings.item_code
Ref: rating_items.item_code - ai_scores.item_code
Ref: participants.id < rating_items.participant_id
Ref: users.username < ratings.rater

Ref: users.id < admin_sessions.user_id
Ref: users.id < audit_log.user_id
Ref: users.id < login_attempts.user_id

Ref: access_codes.id - participants.code_id
Ref: participants.id - behavior_answers.participant_id
Ref: participants.id - self_assessment.participant_id
Ref: participants.id < game_responses.participant_id
Ref: game_responses.id < scores.response_id
Ref: survey_raw.id - survey_clean.id
Ref: schools.id < survey_clean.school_id
Ref: schools.id < participants.school_id
